# Solidify Environment Configuration
# Copy this to .env and fill in your API keys

# =======================
# AI PROVIDERS
# =======================

# NVIDIA NIM (default provider)
NVIDIA_API_KEY=your_nvidia_nim_key_here

# Google Gemini
GEMINI_API_KEY=your_gemini_key_here

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenAI
OPENAI_API_KEY=your_openai_key_here

# Groq
GROQ_API_KEY=your_groq_key_here

# Qwen (Alibaba Cloud)
QWEN_API_KEY=your_qwen_key_here

# MiniMax
MINIMAX_API_KEY=your_minimax_key_here

# Ollama (local, no key needed)
OLLAMA_BASE_URL=http://localhost:11434

# =======================
# DEFAULT MODEL
# =======================
SOLIDIFY_MODEL=nvidia/nvidia-nemotron-nano-9b-v2
SOLIDIFY_PROVIDER=nvidia

# =======================
# BLOCKCHAIN APIs
# =======================
ETHERSCAN_API_KEY=your_etherscan_key_here

# Multi-chain explorers (optional)
BSCSCAN_API_KEY=your_bscscan_key_here
POLYGONSCAN_API_KEY=your_polygonscan_key_here
ARBISCAN_API_KEY=your_arbiscan_key_here
BASESCAN_API_KEY=your_basescan_key_here

# =======================
# APPLICATION
# =======================
ENVIRONMENT=development
PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
